<div class="modal micromodal-slide" id="modal-1" aria-hidden="true">
    <div class="modal__overlay" tabindex="-1" data-micromodal-close>
        <div class="modal__container" role="dialog" aria-modal="true" aria-labelledby="modal-1-title">
            <main class="modal__content" id="modal-1-content">
                <div id="searchbox"></div>
                <div id="counter"></div>
                <div id="hits"></div>
            </main>
        </div>
    </div>
</div>

<script src="{{{uiRootPath}}}/js/vendor/hotkeys.js"></script>
<script src="https://cdn.jsdelivr.net/npm/lunr@2.3.9/lunr.min.js"></script>
<script>
  // Shim to integrate Antora Lunr extension (antoraSearch) with this UI's antoraLunr consumer
  window.antoraLunr = window.antoraLunr || {}
  window.antoraSearch = window.antoraSearch || {}
  window.antoraSearch.initSearch = function (lunrInstance, data) {
    try {
      if (data && data.index && data.store) {
        window.antoraLunr.index = data.index
        window.antoraLunr.store = data.store
      }
    } catch (e) {
      console.error('Error initializing antoraLunr from antoraSearch index:', e)
    }
  }
</script>
<script src="{{{siteRootPath}}}/search-index.js"></script>
<script async id="search-script" src="{{{uiRootPath}}}/js/vendor/search.js" data-stylesheet="{{{uiRootPath}}}/css/vendor/search.css" data-page-version="{{{page.version}}}" data-page-component="{{{page.component.name}}}"></script>
{{#if (eq page.attributes.article 'search')}}
<script id="page-search-script" async src="{{{uiRootPath}}}/js/vendor/page-search.js" data-stylesheet="{{{uiRootPath}}}/css/vendor/search.css" data-page-version="{{{page.version}}}" data-page-component="{{{page.component.name}}}"></script>
{{/if}}
